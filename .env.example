# Все переменные необязательные. Секретов прототипу не нужно.

# Путь к папке с базой SQLite (на Amvera автоматически /data)
# DATA_DIR=./data

# Для масштабирования: PostgreSQL вместо SQLite
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dekanat

# Принудительно ставить флаг Secure на cookie (по HTTPS включается автоматически)
# COOKIE_SECURE=1

# Сколько часов живет сеанс
# SESSION_TTL_HOURS=12

# Если хостинг меняет заголовок Host: доверенные адреса сайта через запятую
# TRUSTED_HOSTS=example.amvera.io
