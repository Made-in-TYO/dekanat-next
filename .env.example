# Все переменные необязательные. Секретов прототипу не нужно.

# Путь к папке с базой SQLite (на Amvera автоматически /data)
# DATA_DIR=./data

# PostgreSQL вместо SQLite: нужен драйвер psycopg (pip install psycopg[binary]), на PostgreSQL прототип не проверялся
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dekanat

# Принудительно ставить флаг Secure на cookie (по HTTPS включается автоматически)
# COOKIE_SECURE=1

# Сколько часов живет сеанс
# SESSION_TTL_HOURS=12

# Если хостинг меняет заголовок Host: доверенные адреса сайта через запятую
# TRUSTED_HOSTS=example.amvera.io

# Сколько прокси стоит перед приложением. Адрес клиента берется из X-Forwarded-For
# на этой позиции справа, и только если запрос пришел с внутреннего адреса
# TRUSTED_PROXY_HOPS=1

# Публичный адрес сайта для ссылки проверки в QR-коде (если прокси не передает схему)
# PUBLIC_BASE_URL=https://example.amvera.io

# Учебный семестр (влияет на четность недель и начало сессии; экзамены и праздники в демо-данных заданы
# на 2026/27 учебный год в app/seed.py и app/config.py)
# SEMESTER_START=2026-09-01
# SEMESTER_END=2026-12-26

# Демо-режим: пересоздавать демо-базу каждый день (DEMO_DAILY_RESET=0 выключает автосброс совсем)
# и после N минут без активности (DEMO_IDLE_RESET_MINUTES=0: только раз в сутки)
# DEMO_DAILY_RESET=1
# DEMO_IDLE_RESET_MINUTES=30
